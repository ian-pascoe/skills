{
  "name": "@ian-pascoe/skills",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsrs",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run check:references",
    "version": "changeset version && bun run format",
    "check:references": "bun scripts/check-references.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "skills": "^1.7.4",
    "tsrs": "^0.20.1-ts7.1.0-beta"
  }
}
